{
  "name": "click-studio",
  "version": "0.6.1",
  "private": true,
  "type": "module",
  "description": "A precise desktop and Android metronome with reference click samples.",
  "author": "zeberity123",
  "repository": {
    "type": "git",
    "url": "https://github.com/zeberity123/custom_click.git"
  },
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:desktop": "node scripts/smoke.mjs",
    "test:features": "node scripts/test-features.mjs",
    "package": "node scripts/package.mjs",
    "package:portable": "electron-builder --config electron-builder.json --win portable --x64 --publish never",
    "test:portable": "node scripts/smoke.mjs --portable",
    "android:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-android.ps1",
    "android:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1",
    "test:android-engine": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-android-engine.ps1",
    "test:android-ui": "node scripts/test-android-ui.mjs",
    "test:update": "node scripts/test-update-ui.mjs",
    "test:update-helper": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-update-helper.ps1"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "playwright": "^1.63.0"
  }
}
